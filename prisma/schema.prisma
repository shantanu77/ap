generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DailyPlan {
  id            String     @id @default(cuid())
  kidId         String
  kid           KidProfile @relation(fields: [kidId], references: [id])
  date          DateTime   @db.Date
  generatedAt   DateTime   @default(now())
  content       Json
  edited        Boolean    @default(false)
  editedContent Json?
  session       Session?

  @@unique([kidId, date])
  @@index([kidId, date])
  @@map("daily_plans")
}

model KidProfile {
  id                 String              @id @default(cuid())
  email              String?             @unique
  name               String
  grade              Int                 @default(6)
  emoji              String              @default("🦊")
  timezone           String              @default("Asia/Kolkata")
  emailVerifiedAt    DateTime?
  guardianAttestedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  plans              DailyPlan[]
  boardSettings      BoardSettings?
  explorations       GeniusExploration[]
  authSessions       AuthSession[]
  ratings            GeniusRating[]

  @@map("kid_profiles")
}

model LoginCode {
  id            String    @id @default(cuid())
  email         String
  codeHash      String
  draftName     String
  draftGrade    Int
  draftEmoji    String
  draftTimezone String    @default("Asia/Kolkata")
  attested      Boolean   @default(false)
  requestHash   String
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, createdAt])
  @@index([requestHash, createdAt])
  @@map("login_codes")
}

model AuthSession {
  id         String     @id @default(cuid())
  kidId      String
  kid        KidProfile @relation(fields: [kidId], references: [id], onDelete: Cascade)
  tokenHash  String     @unique
  expiresAt  DateTime
  lastSeenAt DateTime   @default(now())
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([kidId, expiresAt])
  @@map("auth_sessions")
}

model Session {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  dailyPlanId     String        @unique
  dailyPlan       DailyPlan     @relation(fields: [dailyPlanId], references: [id])
  startedAt       DateTime?
  completedAt     DateTime?
  lateCompletedAt DateTime?
  status          SessionStatus @default(PENDING)
  phases          PhaseRating[]
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("sessions")
}

model PhaseRating {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  phase        Phase
  completed    Boolean  @default(false)
  ratings      Json
  timeSpentSec Int?
  createdAt    DateTime @default(now())

  @@unique([sessionId, phase])
  @@map("phase_ratings")
}

enum SessionStatus {
  PENDING
  PARTIAL
  COMPLETE
  MISSED
}

enum Phase {
  DAY_REVIEW
  READ_ALOUD
  LANGUAGE
  WRITING
  WORK_QUALITY
  NEXT_DAY_PREP
}

model GeniusExploration {
  id             String         @id @default(cuid())
  kidId          String
  kid            KidProfile     @relation(fields: [kidId], references: [id])
  subject        String         @default("chemistry")
  canonicalTopic String
  displayTitle   String
  defaultLevel   Int
  content        Json
  savedSnapshot  Json?
  savedAt        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastOpenedAt   DateTime       @default(now())
  deletedAt      DateTime?
  ratings        GeniusRating[]

  @@index([savedAt])
  @@index([lastOpenedAt])
  @@index([kidId, deletedAt, savedAt])
  @@map("genius_explorations")
}

model GeniusRating {
  id            String            @id @default(cuid())
  kidId         String
  kid           KidProfile        @relation(fields: [kidId], references: [id], onDelete: Cascade)
  explorationId String
  exploration   GeniusExploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  nodeId        String
  rating        Int
  feedback      String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([kidId, explorationId, nodeId])
  @@index([explorationId, nodeId])
  @@map("genius_ratings")
}

model GeniusLessonCache {
  id             String   @id
  subject        String
  canonicalTopic String
  displayTitle   String
  content        Json
  contentVersion Int      @default(1)
  createdAt      DateTime @default(now())

  @@unique([subject, canonicalTopic, contentVersion])
  @@map("genius_lesson_cache")
}

model GeniusDeepDiveCache {
  id             String   @id
  subject        String
  canonicalTopic String
  studyLevel     Int
  queryText      String   @db.VarChar(1000)
  embedding      Json
  node           Json
  contentVersion Int      @default(1)
  createdAt      DateTime @default(now())

  @@index([subject, canonicalTopic, studyLevel, createdAt])
  @@map("genius_deep_dive_cache")
}

model BoardSettings {
  id               String     @id @default(cuid())
  kidId            String     @unique
  kid              KidProfile @relation(fields: [kidId], references: [id], onDelete: Cascade)
  activeDays       Json
  remindersEnabled Boolean    @default(false)
  reminderEmail    String?
  reminderTime     String     @default("18:00")
  lastReminderDate String?
  updatedAt        DateTime   @updatedAt

  @@map("board_settings")
}
