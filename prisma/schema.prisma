generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DailyPlan {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  generatedAt   DateTime @default(now())
  content       Json
  edited        Boolean  @default(false)
  editedContent Json?
  session       Session?

  @@map("daily_plans")
}

model Session {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  dailyPlanId     String        @unique
  dailyPlan       DailyPlan     @relation(fields: [dailyPlanId], references: [id])
  startedAt       DateTime?
  completedAt     DateTime?
  lateCompletedAt DateTime?
  status          SessionStatus @default(PENDING)
  phases          PhaseRating[]
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("sessions")
}

model PhaseRating {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id])
  phase        Phase
  completed    Boolean  @default(false)
  ratings      Json
  timeSpentSec Int?
  createdAt    DateTime @default(now())

  @@unique([sessionId, phase])
  @@map("phase_ratings")
}

enum SessionStatus {
  PENDING
  PARTIAL
  COMPLETE
  MISSED
}

enum Phase {
  DAY_REVIEW
  READ_ALOUD
  LANGUAGE
  WRITING
  WORK_QUALITY
  NEXT_DAY_PREP
}

model GeniusExploration {
  id             String    @id @default(cuid())
  subject        String    @default("chemistry")
  canonicalTopic String
  displayTitle   String
  defaultLevel   Int
  content        Json
  savedSnapshot  Json?
  savedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastOpenedAt   DateTime  @default(now())
  deletedAt      DateTime?

  @@index([savedAt])
  @@index([lastOpenedAt])
  @@map("genius_explorations")
}

model GeniusLessonCache {
  id             String   @id
  subject        String
  canonicalTopic String
  displayTitle   String
  content        Json
  createdAt      DateTime @default(now())

  @@unique([subject, canonicalTopic])
  @@map("genius_lesson_cache")
}

model GeniusDeepDiveCache {
  id             String   @id
  subject        String
  canonicalTopic String
  studyLevel     Int
  queryText      String   @db.VarChar(1000)
  embedding      Json
  node           Json
  createdAt      DateTime @default(now())

  @@index([subject, canonicalTopic, studyLevel, createdAt])
  @@map("genius_deep_dive_cache")
}

model BoardSettings {
  id               String   @id @default("board")
  activeDays       Json
  remindersEnabled Boolean  @default(false)
  reminderEmail    String?
  reminderTime     String   @default("18:00")
  lastReminderDate String?
  updatedAt        DateTime @updatedAt

  @@map("board_settings")
}
